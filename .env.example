# Mapbox public token (pk.*) — haritayı çizer. Gizli değildir ama kaynak koda
# yazılmaz (GitHub sır tarayıcısı engelliyor). Mac'te ~/.zshrc'ye de konabilir.
EXPO_PUBLIC_MAPBOX_TOKEN=

# RevenueCat public SDK anahtarları. Mağazalar AYRI anahtar ister: iOS anahtarıyla
# Play'de configure çağırmak sessizce boş teklif listesi döndürür, paywall boş gelir.
# Boşken paywall plan yükleyemez.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Twice proje anahtarı (tw_*). Boşken analytics/remote config/force update sessizce kapalıdır.
EXPO_PUBLIC_TWICE_KEY=
